{
  "expo": {
    "name": "MesadAI",
    "slug": "mesada-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mesada-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00C472"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Tire fotos para comprovar tarefas concluídas.",
        "NSPhotoLibraryUsageDescription": "Selecione uma foto da galeria para comprovar tarefas."
      }
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Use a câmera para escanear o código de pareamento."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecione fotos para comprovar tarefas.",
          "cameraPermission": "Tire fotos para comprovar tarefas."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#00C472"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
